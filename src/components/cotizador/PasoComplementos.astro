---
import { PRECIOS } from "@/config/precios";
import { MAX_EQUIPOS } from "@/lib/quote/validacion";
import { etiquetaComplemento, normalizar } from "@/lib/cotizador/textos";

const grupos = PRECIOS.ordenGrupos.filter((g) => PRECIOS.complementos.some((k) => k.grupo === g));
---

<h1>Suma <span>complementos</span> a tu paquete</h1>
<p class="intro">Cada complemento indica si se suma al precio mensual o si es de pago único.</p>

<div class="card barra-total" id="barraTotal"></div>

<section class="comp" aria-labelledby="comp-t">
  <div class="comp-head">
    <span class="plus">PLUS</span>
    <div>
      <h2 id="comp-t">Complementos y accesorios</h2>
      <p>Opcionales. Busca por nombre o filtra por forma de cobro.</p>
    </div>
  </div>

  <div class="comp-busca">
    <label class="c busca">Buscar complemento o accesorio
      <input type="search" id="compBus" placeholder="Por ejemplo: contrato, registro patronal, NOM-035" />
    </label>
    <div class="filtros" id="compFiltros" role="group" aria-label="Forma de cobro">
      <button type="button" class="sel" data-f="todos" aria-pressed="true">Todos</button>
      <button type="button" data-f="mensual" aria-pressed="false">Mensuales</button>
      <button type="button" data-f="unico" aria-pressed="false">Pago único</button>
    </div>
  </div>

  <div class="comp-grid" id="compGrid">
    {grupos.map((g) => (
      <div class="cg">
        <h3>{g}</h3>
        <ul>
          {PRECIOS.complementos.filter((k) => k.grupo === g).map((k) => (
            <li
              data-comp={k.id}
              data-tipo={k.tipo === "unico" ? "unico" : "mensual"}
              data-txt={normalizar(`${k.nombre} ${k.descripcion} ${g}`)}
              role="checkbox"
              aria-checked="false"
              tabindex="0"
            >
              <b>{k.nombre}</b>
              <span>{k.descripcion}</span>
              <span class="pr" data-pr={k.id}>{etiquetaComplemento(k)}</span>
              {k.tipo === "equipo" && (
                <label class="bio">
                  Equipos:
                  <input type="number" min="1" max={MAX_EQUIPOS} value="1" id="bioN" aria-label="Número de equipos biométricos" />
                </label>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <p class="ayuda" id="compVacio" hidden>No encontramos complementos con esa búsqueda. Prueba con otra palabra.</p>
</section>

<div class="acciones">
  <button class="btn sec" type="button" data-ir="1">Volver</button>
  <button class="btn pri" type="button" data-ir="3">Continuar</button>
</div>
