---
import { PRECIOS } from "@/config/precios";
import { MAX_COLABORADORES } from "@/lib/quote/validacion";
import PlanCard from "./PlanCard.astro";
import ComparativaTabla from "./ComparativaTabla.astro";
import { paquetes, gruposParaNivel } from "@/lib/cotizador/catalogo";
const periodos = Object.entries(PRECIOS.periodicidad);
---

<h1>Cotiza tu servicio de <span>nómina</span></h1>
<p class="intro">Responde tres preguntas y te mostramos el precio de cada paquete al momento.</p>

<div class="f1">
  <div class="f1-izq">
    <p class="f1-titulo"><span>1.</span> ¿Cuántos colaboradores tiene tu empresa?</p>
    <p class="f1-ayuda">Escribe el número o mueve la barra.</p>
    <input type="number" id="num" class="f1-num" min="1" max={MAX_COLABORADORES} value="25" aria-label="Número de colaboradores" />
    <input type="range" id="rango" class="f1-rango" min="1" max="300" value="25" aria-label="Colaboradores" />
    <div class="f1-marcas"><span>1</span><span>75</span><span>150</span><span>225</span><span>300</span></div>
    <p class="aviso" id="avisoMedida">Más de 300 colaboradores: preparamos una cotización a la medida. Continúa y agenda una sesión con nuestro equipo.</p>
  </div>

  <div class="f1-der">
    <section class="f1-bloque">
      <p class="f1-titulo"><span>2.</span> ¿Cómo está constituida tu empresa?</p>
      <p class="f1-ayuda">Empresas con RFC propio y sus registros ante el IMSS.</p>
      <div class="f1-grid tres">
        <label class="f1-campo">Razones sociales<input type="number" id="razones" min="1" max="50" value="1" /></label>
        <label class="f1-campo">Registros patronales<input type="number" id="regs" min="1" max="50" value="1" /></label>
        <label class="f1-campo">Salarios
          <select id="salarios">
            <option value="fijos" selected>Fijos</option>
            <option value="variables">Variables o mixtos</option>
          </select>
        </label>
      </div>
    </section>

    <section class="f1-bloque">
      <p class="f1-titulo"><span>3.</span> ¿Cuántas nóminas manejas y de qué tipo?</p>
      <p class="f1-ayuda">Cuenta cada nómina que se calcula por separado.</p>
      <div class="f1-grid cuatro">
        <label class="f1-campo">Nóminas<input type="number" id="nominas" min="1" max="20" value="1" /></label>
        <label class="f1-campo">Periodicidad
          <select id="periodo">
            {periodos.map(([k, v]) => <option value={k} selected={k === "quincenal"}>{v.texto}</option>)}
          </select>
        </label>
        <label class="f1-campo">Nóminas de asimilados<input type="number" id="asim" min="0" max="20" value="0" /></label>
        <label class="f1-campo">Periodicidad
          <select id="periodoAsim">
            {periodos.map(([k, v]) => <option value={k} selected={k === "mensual"}>{v.texto}</option>)}
          </select>
        </label>
      </div>
    </section>
  </div>
</div>

<h2 class="sec-h">Elige el paquete que <span>acompaña a tu empresa</span></h2>
<p class="intro">Cada paquete incluye todo lo del anterior. Precios mensuales para <b id="nTxt">25</b> colaboradores con nómina <b id="perTxt">quincenal</b>, más IVA.</p>

<section class="planes" role="radiogroup" aria-label="Paquetes NOMENEX">
  {paquetes.map((p) => <PlanCard paquete={p} grupos={gruposParaNivel(p.nivel)} />)}
</section>

<div class="barra">
  <h2>Compara los paquetes</h2>
  <button class="toggle" type="button" aria-expanded="false" aria-controls="tabla">Ver comparativo completo</button>
</div>
<ComparativaTabla />

<p class="nota">Precios mensuales más IVA. En el comparativo, toca <b>Agregar</b> en un complemento para sumarlo al precio de los paquetes.</p>
<div class="acciones">
  <span></span>
  <button class="btn pri" type="button" id="cont2" data-ir="2" disabled>Continuar</button>
</div>
