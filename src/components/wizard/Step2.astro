---
import paquetes from "@/data/paquetes.json";
import { PRECIOS, type Complemento } from "@/config/precios";
import PaqueteItem from "./paquetes/PaqueteItem.astro";

const { data } = Astro.props;
const elegidos: string[] = data.complementos ?? [];

// El biométrico se cotiza en el paso 3 (comodato, por equipo).
const mensuales = PRECIOS.complementos.filter((c) => c.tipo !== "unico" && c.id !== "bio");
const grupos = [...new Set(mensuales.map((c) => c.grupo))];
const unicos = PRECIOS.complementos.filter((c) => c.tipo === "unico");

const etiqueta = (c: Complemento) =>
  c.tipo === "colab"
    ? `$${c.precio} por colaborador al mes`
    : `Pago único: $${(c.base ?? 0).toLocaleString("es-MX")} + $${c.precio} por colaborador`;
---

<form id="step2Form" class="pt-1">
  <input type="hidden" name="step" value="2" />
  <input type="hidden" name="packageId" id="selectedPackageId" value={data.packageId || ""} />

  <h2 class="titulo-paso">2. Elige tu paquete y complementos</h2>
  <p class="text-sm text-slate-500 mb-2">Compara los paquetes y suma los complementos que necesitas.</p>

  <div id="paquetesContainer" class="planes" role="radiogroup" aria-label="Paquetes NOMENEX">
    {paquetes.map((paquete) => (
      <PaqueteItem paquete={paquete} isSelected={data.packageId === paquete.id} />
    ))}
  </div>

  <section class="comp">
    <div class="comp-head">
      <span class="plus">+</span>
      <div>
        <h2>Complementos</h2>
        <p>Se suman al paquete. Precios antes de IVA.</p>
      </div>
    </div>

    <div class="comp-grid">
      {grupos.map((grupo) => (
        <div class="cg">
          <h3>{grupo}</h3>
          <ul>
            {mensuales.filter((c) => c.grupo === grupo).map((c) => (
              <li>
                <label class="cg-item">
                  <input type="checkbox" data-complemento={c.id} checked={elegidos.includes(c.id)} />
                  <span>
                    <span class="cg-nombre">{c.nombre}</span>
                    <span class="cg-desc">{c.descripcion}</span>
                    <span class="pr">{etiqueta(c)}</span>
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="cg">
        <h3>Consultoría (pago único)</h3>
        <ul>
          {unicos.map((c) => (
            <li>
              <label class="cg-item">
                <input type="checkbox" data-complemento={c.id} checked={elegidos.includes(c.id)} />
                <span>
                  <span class="cg-nombre">{c.nombre}</span>
                  <span class="cg-desc">{c.descripcion}</span>
                  <span class="pr">{etiqueta(c)}</span>
                </span>
              </label>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="barra-total">
    <div>
      <span>Total estimado mensual</span><br />
      <small>Pago único de consultoría: <span data-live="total-unico">—</span></small><br />
      <small>Sedes y biométricos se suman en los siguientes pasos.</small>
    </div>
    <b data-live="total-mensual">—</b>
  </div>

  <div class="acciones">
    <button type="button" id="backBtn" class="btn sec">Volver</button>
    <button type="submit" id="submitBtn" class="btn pri">Continuar</button>
  </div>
</form>

<script>
  import { actions } from "astro:actions";

  if (typeof window === "undefined") {
    throw new Error("This script should only run on the client");
  }

  function initializeStep2() {
    const form = document.querySelector("#step2Form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement | null;
    const backBtn = document.getElementById("backBtn") as HTMLButtonElement | null;
    const hiddenInput = document.getElementById("selectedPackageId") as HTMLInputElement | null;

    if (!form || !submitBtn || !backBtn || !hiddenInput) {
      console.error("[Step2] Required elements not found");
      return;
    }

    const paqueteCards = Array.from(form.querySelectorAll<HTMLElement>(".paqueteCard"));
    const checks = form.querySelectorAll<HTMLInputElement>("input[data-complemento]");

    const seleccionar = (card: HTMLElement) => {
      const id = card.dataset.packageId;
      if (id) hiddenInput.value = id;
      paqueteCards.forEach((otra) => {
        const activo = otra === card;
        otra.classList.toggle("activo", activo);
        otra.setAttribute("aria-checked", String(activo));
      });
    };

    paqueteCards.forEach((card) => {
      card.addEventListener("click", () => seleccionar(card));
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          seleccionar(card);
        }
      });
    });

    const handleBack = () => document.dispatchEvent(new CustomEvent("wizard:prev"));

    const handleSubmit = async (e: Event) => {
      e.preventDefault();

      if (!hiddenInput.value) {
        window.showAlert?.("Por favor, selecciona un paquete para continuar.", "error");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Guardando...";

      try {
        const formData = new FormData(form);
        formData.set(
          "complementos",
          Array.from(checks)
            .filter((c) => c.checked)
            .map((c) => c.dataset.complemento)
            .join(",")
        );

        const response = await actions.wizardStep(formData);

        if (response.error) {
          window.showAlert?.(response.error.message || "Error al guardar el paquete", "error");
          return;
        }

        if (response.data?.success) {
          window.showAlert?.("✓ Paquete y complementos guardados", "success", 1500);
          setTimeout(() => document.dispatchEvent(new CustomEvent("wizard:next")), 1500);
        }
      } catch (error) {
        window.showAlert?.("Error inesperado. Por favor intenta de nuevo.", "error");
        console.error("[Step2] Submit error:", error);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Continuar";
      }
    };

    backBtn.addEventListener("click", handleBack);
    form.addEventListener("submit", handleSubmit);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeStep2);
  } else {
    initializeStep2();
  }
</script>
