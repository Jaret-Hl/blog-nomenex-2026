---
import { PRECIOS } from "@/config/precios";

const { data } = Astro.props;
const bio = PRECIOS.complementos.find(c => c.id === "bio")!;
---

<form id="step3Form" class="pt-4 max-w-3xl mx-auto">
  <input type="hidden" name="step" value="3" />
  <div class="space-y-4">
    <h2 class="text-xl font-medium">3. Biométricos en comodato</h2>
    <p class="text-sm text-slate-600 dark:text-white/70 mt-2">
      Los checadores se entregan en comodato: no compras el equipo, solo pagas la renta mensual por dispositivo.
    </p>

    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="flex items-center gap-3">
          <input type="radio" name="bioRequired" value="true" id="bioNeededYes" checked={data.biometric?.bioRequired === true} />
          <span>Sí, quiero biométricos en comodato</span>
        </label>
        <label class="flex items-center gap-3 mt-3">
          <input type="radio" id="bioNeededNo" name="bioRequired" value="false"
            checked={data.biometric?.bioRequired === false || !data.biometric?.bioRequired} />
          <span>No por ahora</span>
        </label>

        <div id="bioDetails" class="mt-4 hidden">
          <label class="block text-sm">Número de dispositivos</label>
          <input id="bioCount" name="bioCount" type="number" min="1" max="100"
            value={data.biometric?.bioCount ?? 1}
            class="mt-1 block w-28 rounded-md border px-3 py-2" />
          <p class="text-xs text-slate-600 dark:text-white/70 mt-3">
            ${bio.precio} por equipo al mes, antes de IVA. Total de biométricos:
            <b data-live="bio-costo">—</b> al mes.
          </p>
        </div>
      </div>

      <div>
        <div class="bg-gray-50 dark:bg-gray-800 p-4 rounded-md border-2 border-dashed border-slate-200 dark:border-slate-700 mb-4">
          <div class="font-medium">Incluye</div>
          <ul class="list-disc ml-5 mt-2 text-sm text-slate-600 space-y-1 dark:text-white/70">
            <li>Instalación en sitio</li>
            <li>Configuración y pruebas</li>
            <li>Capacitación inicial</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="flex justify-between mt-6">
    <button type="button" id="backBtn3" class="btn sec">
      Volver
    </button>
    <button type="submit" id="submitBtn" class="btn pri">
      Continuar
    </button>
  </div>
</form>

<script>
  import { actions } from "astro:actions";
  import { AlertManager } from "../../lib/alertUtils";

  if (typeof window === 'undefined') {
    throw new Error('This script should only run on the client');
  }

  function initializeStep3() {
    const form = document.querySelector("#step3Form") as HTMLFormElement | null;
    const backBtn3 = document.getElementById("backBtn3") as HTMLButtonElement | null;
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement | null;
    const bioNeededYes = document.getElementById("bioNeededYes") as HTMLInputElement | null;
    const bioNeededNo = document.getElementById("bioNeededNo") as HTMLInputElement | null;
    const bioDetails = document.getElementById("bioDetails") as HTMLDivElement | null;
    const bioCount = document.getElementById("bioCount") as HTMLInputElement | null;

    if (!form || !backBtn3 || !submitBtn || !bioNeededYes || !bioNeededNo || !bioDetails || !bioCount) {
      console.error('[Step3] Required elements not found');
      return;
    }

    const actualizarDetalle = () => bioDetails.classList.toggle("hidden", !bioNeededYes.checked);

    const handleBack = (e: Event) => {
      e.preventDefault();
      document.dispatchEvent(new CustomEvent("wizard:prev"));
    };

    function validar(): boolean {
      if (!bioNeededYes!.checked && !bioNeededNo!.checked) {
        window.showAlert?.("Por favor, indica si requieres biométricos.", "error");
        return false;
      }
      if (bioNeededYes!.checked) {
        const n = parseInt(bioCount!.value || "");
        if (!n || n < 1) {
          window.showAlert?.("Ingresa un número válido de dispositivos (mínimo 1).", "error");
          bioCount!.focus();
          return false;
        }
        if (n > 100) {
          window.showAlert?.("El número máximo de dispositivos es 100. Para cantidades mayores, contacta a ventas.", "error");
          bioCount!.focus();
          return false;
        }
      }
      return true;
    }

    const handleSubmit = async (e: Event) => {
      e.preventDefault();
      if (!validar()) return;

      submitBtn.disabled = true;
      submitBtn.textContent = "Guardando...";

      try {
        const formData = new FormData(form);
        if (bioNeededNo.checked) {
          formData.set("bioRequired", "false");
          formData.delete("bioCount");
          formData.delete("bioType");
        } else {
          formData.set("bioRequired", "true");
          formData.set("bioCount", String(parseInt(bioCount.value) || 1));
          formData.set("bioType", "basic");
        }

        const response = await actions.wizardStep(formData);

        if (response.error) {
          window.showAlert?.(response.error.message || "Error al guardar la configuración biométrica", "error");
          return;
        }
        if (response.data?.success) {
          window.showAlert?.("✓ Configuración biométrica guardada", "success", 1500);
          setTimeout(() => document.dispatchEvent(new CustomEvent("wizard:next")), 1500);
        }
      } catch (error) {
        window.showAlert?.("Error inesperado. Por favor intenta de nuevo.", "error");
        console.error('[Step3] Submit error:', error);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Continuar";
      }
    };

    actualizarDetalle();
    backBtn3.addEventListener("click", handleBack);
    bioNeededYes.addEventListener("change", actualizarDetalle);
    bioNeededNo.addEventListener("change", actualizarDetalle);
    form.addEventListener("submit", handleSubmit);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeStep3);
  } else {
    initializeStep3();
  }
</script>
