---
interface Props {
  paquete: {
    id: string;
    nombre: string;
    etiqueta: string;
    descripcion?: string;
    caracteristicas: Array<{ label: string; incluido: boolean; nota?: string }>;
  };
  isSelected: boolean;
}

const { paquete, isSelected } = Astro.props;
// Igual que el cotizador: el Profesional lleva la insignia de recomendado
const recomendado = paquete.id === "profesional";
const incluidos = paquete.caracteristicas.filter((c) => c.incluido);
---

<article
  data-package-id={paquete.id}
  role="radio"
  tabindex="0"
  aria-checked={String(isSelected)}
  class:list={[
    "plan paqueteCard",
    recomendado && "destacado",
    isSelected && "activo",
  ]}
>
  {recomendado && <span class="insignia">Recomendado</span>}
  <span class="etiqueta">{paquete.etiqueta}</span>
  <h2>{paquete.nombre}</h2>
  {paquete.descripcion && <p class="promesa">{paquete.descripcion}</p>}

  <div class="precio">
    Mensual, antes de sedes y complementos
    <b data-precio-paquete={paquete.id}>—</b>
    <span class="por">+ IVA</span>
  </div>

  <div class="grupo">
    <h3>Incluye</h3>
    <ul>
      {incluidos.map((c) => (
        <li>
          {c.label}
          {c.nota && <small> ({c.nota})</small>}
        </li>
      ))}
    </ul>
  </div>

  <div class="espacio"></div>
  <button type="button" class="elegir">{isSelected ? "Seleccionado" : "Elegir"}</button>
</article>
