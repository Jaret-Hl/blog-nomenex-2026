---
import Alert from '../components/ui/Alert.astro';
import '../styles/cotizador.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo-n.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <title>NOMENEX · Cotiza tu servicio de nómina</title>
    <meta name="description" content="Cotiza tu servicio de nómina NOMENEX: paquetes, complementos y biométricos en comodato." />
    <meta name="keywords" content="NOMENEX, nómina, cotización, biométricos" />
    <meta name="author" content="NOMENEX" />
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <div class="min-h-screen w-full">
      <slot />
    </div>

    <!-- Alert global - una sola instancia para toda la aplicación -->
    <Alert id="global-alert" position="bottom-right" />
  </body>
</html>

<style is:global>
  @import "tailwindcss";
  @plugin "@midudev/tailwind-animations";

  /* Modo oscuro desactivado: la identidad es clara, como el cotizador */
  @custom-variant dark (&:where(.dark, .dark *));

  /* Paleta del cotizador. Sobrescribe los colores de Tailwind usados en el wizard y el formulario */
  @theme {
    --font-sans: "Inter", system-ui, sans-serif;
    --color-slate-50: #F6F7F9;
    --color-slate-200: #DDE2E8;
    --color-slate-500: #5B6675;
    --color-slate-600: #3A7CC0;
    --color-slate-700: #24518A;
    --color-slate-800: #1F2A37;
    --color-yellow-400: #FFB066;
    --color-yellow-500: #FF9933;
    --color-yellow-600: #C4600A;
    --color-blue-500: #3A7CC0;
    --color-blue-600: #24518A;
  }

  body {
    background: #F6F7F9;
    color: #1F2A37;
    font-family: "Inter", system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4 {
    font-family: "Inter", system-ui, sans-serif;
  }
</style>
