---
import Layout from "../layouts/Layout.astro";
import Header from "../sections/Header.astro";
import Hero from "../sections/Hero.astro";
import Footer from "../sections/Footer.astro";

// En modo embebido (?embed=1) se oculta el encabezado y el pie, porque los pone la página anfitriona.
const embebido = Astro.url.searchParams.get("embed") === "1";
---

<Layout>
  <div class="flex min-h-screen flex-col">
    {!embebido && <Header />}
    <div class="flex flex-1">
      <Hero />
    </div>
    {!embebido && <Footer />}
  </div>
</Layout>

<script>
  import { reportarAltura } from "@/lib/embed/altura";
  reportarAltura();
</script>
