---
import Cotizador from "../components/cotizador/Cotizador.astro";
---

<div class="w-full">
  <section
    class="relative isolate overflow-hidden bg-[linear-gradient(120deg,#24518A_0%,#3A7CC0_60%,#4F93D6_100%)] text-white before:pointer-events-none before:absolute before:-right-[120px] before:-bottom-[160px] before:h-[420px] before:w-[420px] before:rounded-full before:border-[56px] before:border-[rgba(255,153,51,0.22)] before:content-['']"
  >
    <div class="relative z-10 mx-auto flex max-w-[1180px] flex-col items-start justify-between gap-8 px-6 pt-11 pb-12 md:flex-row md:items-center">
      <div class="max-w-[640px]">
        <span class="inline-block rounded-full bg-white/15 px-3 py-1.5 text-xs font-extrabold uppercase tracking-[1.5px]">
          Planeación y gestión estratégica de nómina
        </span>

        <h2 class="mt-3.5 mb-2.5 text-[28px] font-extrabold leading-[1.15] md:text-[38px]">
          Tu nómina en orden, <span class="text-[#FFC48A]">con precio claro desde hoy</span>
        </h2>

        <p class="max-w-[600px] text-base opacity-90">
          Calcula en minutos cuánto cuesta tu servicio: elige paquete, suma complementos y recibe tu propuesta.
        </p>

        <ul class="mt-[18px] flex flex-wrap gap-2.5">
          <li class="inline-flex items-center gap-1 rounded-full bg-white px-3 py-[7px] text-[13px] font-bold text-[#24518A]">
            <span class="text-[#FF9933]">✓</span>Nómina, IMSS e INFONAVIT
          </li>
          <li class="inline-flex items-center gap-1 rounded-full bg-white px-3 py-[7px] text-[13px] font-bold text-[#24518A]">
            <span class="text-[#FF9933]">✓</span>Timbrado CFDI
          </li>
          <li class="inline-flex items-center gap-1 rounded-full bg-white px-3 py-[7px] text-[13px] font-bold text-[#24518A]">
            <span class="text-[#FF9933]">✓</span>Asesoría especializada
          </li>
        </ul>
      </div>

      <div
        class="hidden h-60 w-60 shrink-0 place-items-center rounded-[40px] bg-white shadow-[0_18px_40px_rgba(14,40,74,0.35)] md:grid -rotate-6"
        aria-hidden="true"
      >
        <img src="/brand/isotipo-nomenex.svg" alt="" width="170" height="170" class="w-[170px] rotate-6" />
      </div>
    </div>
  </section>

  <main class="wrap">
    <Cotizador />
  </main>
</div>  
